MONGODB_URI=mongodb-uri

# JWT secret for authentication (required)
JWT_SECRET=jwt-secret

# Password reset token secret (used to sign reset links)
RESET_TOKEN_SECRET=reset-token-secret
FRONTEND_URL=https://voucher-system-client.netlify.app

# SMTP configuration for nodemailer
SMTP_HOST=smtp-host
SMTP_PORT=smtp-port
SMTP_SECURE=smtp-secure
SMTP_USER=smtp-user
SMTP_PASS=smtp-pass
SMTP_FROM=smtp-from

PORT=3001
